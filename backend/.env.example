# ===================================================================
# SellPhone24 Backend Environment Configuration Template
# ===================================================================

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set your local MongoDB or MongoDB Atlas URI:
# e.g., mongodb://localhost:27017/sellphone24 or mongodb+srv://<user>:<password>@cluster0...
MONGODB_CONNECTION=mongodb://localhost:27017/sellphone24
MONGODB_URI=mongodb://localhost:27017/sellphone24

# Clerk Authentication (matches frontend .env.local)
CLERK_PUBLISHABLE_KEY=pk_test_cm9idXN0LXZ1bHR1cmUtMjIuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=sk_test_hvc1PLEeeTphAcIgkb6mMO68q2b3CPBazNSIzvDLAK

# Admin Email Allowlist (comma separated)
ADMIN_EMAILS=admin@sellyourphone24.com,shaun@sellyourphone24.com

# Google Sheets Automated Sync Webhooks
# Option 1 (Recommended): Single Google Apps Script Webhook URL handling both Sell Leads and Buy Orders in one spreadsheet:
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec

# Option 2 (Optional): Dedicated individual Webhook URLs if using separate sheets:
GOOGLE_SHEET_SELL_LEADS_WEBHOOK_URL=
GOOGLE_SHEET_BUY_ORDERS_WEBHOOK_URL=

# Buy Phones Email Notifications (Nodemailer SMTP - Optional)
# Configure your transactional email credentials to send order receipts to customers & alerts to admin:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_NOTIFICATION_EMAIL=admin@sellyourphone24.com

# Cloudinary Storage for Device & Phone Image Uploads (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
